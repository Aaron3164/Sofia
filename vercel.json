{
  "crons": [
    {
      "path": "/api/sentinel",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/sentinel",
      "dest": "/api/sentinel.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
